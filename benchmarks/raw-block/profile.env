# Raw block device (volumeMode: Block). STORAGE_CLASS must support block volumes.
# WARNING: the tests overwrite the whole device of every PVC they create.
: "${STORAGE_CLASS:=}"
: "${PVC_SIZE:=50Gi}"          # per daemon (layout multi) / shared device (layout single)
: "${ACCESS_MODE:=ReadWriteOnce}"
MIX_SMALL_DEFAULT=4k

[ -n "$STORAGE_CLASS" ] || die "set STORAGE_CLASS (a StorageClass that supports volumeMode: Block)"

profile_values() {
  local perpod=true; [ "$LAYOUT" = single ] && perpod=false
  echo "protocol: block"
  echo "persistence:"
  echo "  storageClass: \"$STORAGE_CLASS\""
  echo "  size: $PVC_SIZE"
  echo "  accessModes: [$ACCESS_MODE]"
  echo "  perPod: $perpod"
}
