# Raw block device (volumeMode: Block). STORAGE_CLASS must support block volumes.
# WARNING: the tests overwrite the whole device of every PVC they create.
: "${STORAGE_CLASS:=}"
: "${PVC_SIZE:=}"              # per daemon (layout multi) / shared device (layout single). Default: sized for the dataset
: "${ACCESS_MODE:=ReadWriteOnce}"
MIX_SMALL_DEFAULT=4k
# Latency targets (ms) for NVMe/TCP-class block devices (same as xfs). Large-block tests: x TPUT_LAT_FACTOR (10).
: "${LAT_READ=2/5}"           # avg/p99 in ms
: "${LAT_WRITE=2/10}"
: "${DATASET_SIZE:=4t}"      # total of all daemons; see run.sh size_dataset

[ -n "$STORAGE_CLASS" ] || die "set STORAGE_CLASS (a StorageClass that supports volumeMode: Block)"

profile_values() {
  local perpod=true; [ "$LAYOUT" = single ] && perpod=false
  echo "protocol: block"
  echo "persistence:"
  echo "  storageClass: \"$STORAGE_CLASS\""
  echo "  size: $PVC_SIZE"
  echo "  accessModes: [$ACCESS_MODE]"
  echo "  perPod: $perpod"
}
