# S3 object storage.
# Credentials: S3_SECRET_NAME = existing Secret with AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY,
# or S3_ACCESS_KEY + S3_SECRET_KEY (the runner creates the Secret "<release>-s3-creds";
# keys never end up in the results folder).
: "${S3_ENDPOINT:=}"           # e.g. http://minio.minio.svc:9000 (comma separated for several)
: "${S3_REGION:=}"
: "${S3_SECRET_NAME:=}"
: "${S3_ACCESS_KEY:=}"
: "${S3_SECRET_KEY:=}"
: "${BUCKET_PREFIX:=elbencho}" # buckets: <prefix>-1..N (multi) and <prefix>-single
: "${BUCKETS:=4}"              # buckets used by the multi-bucket tests
: "${OBJ_SIZE:=4k}"            # object size of the IOPS tests (01, 02, 08, 09)
MIX_SMALL_DEFAULT="1k:1,2k:1,4k:1"

[ -n "$S3_ENDPOINT" ] || die "set S3_ENDPOINT"
[ -n "$S3_SECRET_NAME" ] || [ -n "$S3_ACCESS_KEY" ] || die "set S3_SECRET_NAME or S3_ACCESS_KEY + S3_SECRET_KEY"

profile_predeploy() {
  if [ -z "$S3_SECRET_NAME" ]; then
    S3_SECRET_NAME="$REL-s3-creds"
    kubectl -n "$NAMESPACE" create secret generic "$S3_SECRET_NAME" \
      --from-literal=AWS_ACCESS_KEY_ID="$S3_ACCESS_KEY" --from-literal=AWS_SECRET_ACCESS_KEY="$S3_SECRET_KEY" \
      --dry-run=client -o yaml | kubectl apply -f - >/dev/null
  fi
}

profile_values() {
  echo "protocol: s3"
  echo "s3:"
  echo "  endpoints: \"$S3_ENDPOINT\""
  [ -n "$S3_REGION" ] && echo "  region: \"$S3_REGION\""
  echo "  existingSecret: \"$S3_SECRET_NAME\""
}
