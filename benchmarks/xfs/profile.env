# XFS on block storage. STORAGE_CLASS must provision volumes formatted as XFS, e.g.
#   CSI:       parameters: { csi.storage.k8s.io/fstype: xfs }
#   local PVs: spec.local.fsType: xfs
# The runner checks that /data is really XFS and warns otherwise.
: "${STORAGE_CLASS:=}"
: "${PVC_SIZE:=}"              # per daemon (layout multi) / shared volume (layout single). Default: sized for the dataset
: "${ACCESS_MODE:=ReadWriteOnce}"
: "${FILE_SIZE:=64g}"           # dataset file size; the number of files follows from DATASET_SIZE
MIX_SMALL_DEFAULT=4k
EXPECT_FS=xfs
# Latency targets (ms) for XFS on NVMe/TCP-class block storage. Write: the "lenient" level (vendor all-flash
# figures: ~0.3-1 ms average at full load, local NVMe XFS p99 ~0.6 ms). Large-block tests: x TPUT_LAT_FACTOR (10).
: "${LAT_READ=2/5}"           # avg/p99 in ms
: "${LAT_WRITE=2/10}"
: "${DATASET_SIZE:=4t}"      # total of all daemons; see run.sh size_dataset

[ -n "$STORAGE_CLASS" ] || die "set STORAGE_CLASS (a StorageClass that formats volumes as XFS)"

profile_values() {
  local perpod=true; [ "$LAYOUT" = single ] && perpod=false
  echo "protocol: file"
  echo "persistence:"
  echo "  storageClass: \"$STORAGE_CLASS\""
  echo "  size: $PVC_SIZE"
  echo "  accessModes: [$ACCESS_MODE]"
  echo "  perPod: $perpod"
}
