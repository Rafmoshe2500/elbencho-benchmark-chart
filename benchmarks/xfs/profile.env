# XFS on block storage. STORAGE_CLASS must provision volumes formatted as XFS, e.g.
#   CSI:       parameters: { csi.storage.k8s.io/fstype: xfs }
#   local PVs: spec.local.fsType: xfs
# The runner checks that /data is really XFS and warns otherwise.
: "${STORAGE_CLASS:=}"
: "${PVC_SIZE:=50Gi}"          # per daemon (layout multi) / shared volume (layout single)
: "${ACCESS_MODE:=ReadWriteOnce}"
: "${FILES:=8}"                # dataset: FILES x FILE_SIZE must fit into PVC_SIZE
: "${FILE_SIZE:=4g}"
MIX_SMALL_DEFAULT=4k
EXPECT_FS=xfs

[ -n "$STORAGE_CLASS" ] || die "set STORAGE_CLASS (a StorageClass that formats volumes as XFS)"

profile_values() {
  local perpod=true; [ "$LAYOUT" = single ] && perpod=false
  echo "protocol: file"
  echo "persistence:"
  echo "  storageClass: \"$STORAGE_CLASS\""
  echo "  size: $PVC_SIZE"
  echo "  accessModes: [$ACCESS_MODE]"
  echo "  perPod: $perpod"
}
