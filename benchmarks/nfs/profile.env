# NFS profile. Two ways to attach the export:
#   1) NFS_SERVER + NFS_PATH  -> the chart creates a static NFS PV with the mount options below
#   2) NFS_STORAGE_CLASS      -> an existing NFS StorageClass (csi-driver-nfs, nfs-subdir...) as RWX PVC;
#                                mount options then come from the StorageClass, not from here.
: "${NFS_SERVER:=}"
: "${NFS_PATH:=/}"
: "${NFS_STORAGE_CLASS:=}"
: "${NFS_VERS:=4.1}"          # 3 | 4.0 | 4.1 | 4.2
: "${NCONNECT:=8}"            # TCP connections per mount (Linux >= 5.3). 0 = do not set
: "${RSIZE:=1048576}"
: "${WSIZE:=1048576}"
: "${NFS_EXTRA_OPTS:=hard}"   # comma separated, e.g. "hard,noatime,actimeo=0"
: "${PVC_SIZE:=500Gi}"        # nominal size (NFS does not enforce it)
: "${FILES:=8}"               # dataset files per daemon (layout multi) / in total (layout single)
: "${FILE_SIZE:=4g}"
MIX_SMALL_DEFAULT=4k
EXPECT_FS=nfs

[ -n "$NFS_SERVER$NFS_STORAGE_CLASS" ] || die "set NFS_SERVER (+NFS_PATH) or NFS_STORAGE_CLASS"
[ -z "$NFS_SERVER" ] && NCONNECT=""   # StorageClass mode: mount options come from the StorageClass

nfs_opts() {
  local o="nfsvers=$NFS_VERS,rsize=$RSIZE,wsize=$WSIZE"
  [ "${NCONNECT:-0}" != 0 ] && o="$o,nconnect=$NCONNECT"
  [ -n "$NFS_EXTRA_OPTS" ] && o="$o,$NFS_EXTRA_OPTS"
  echo "$o"
}

profile_values() {
  local sub=false; [ "$LAYOUT" = multi ] && sub=true   # multi: private sub dir per daemon on the export
  if [ -n "$NFS_SERVER" ]; then
    echo "protocol: nfs"
    echo "nfs:"
    echo "  server: \"$NFS_SERVER\""
    echo "  path: \"$NFS_PATH\""
    echo "  size: $PVC_SIZE"
    echo "  mountOptions: [$(nfs_opts | sed 's/,/, /g')]"
    # restart the daemons when mount options change (a running mount keeps its old options)
    echo "podAnnotations: {elbencho-bench/mount-options: \"$(nfs_opts)\"}"
    echo "persistence: {subPathPerPod: $sub}"
  else
    warn "NFS_STORAGE_CLASS mode: NCONNECT/RSIZE/WSIZE/NFS_VERS come from the StorageClass"
    echo "protocol: file"
    echo "persistence: {storageClass: \"$NFS_STORAGE_CLASS\", size: $PVC_SIZE, accessModes: [ReadWriteMany], perPod: false, subPathPerPod: $sub}"
  fi
}
